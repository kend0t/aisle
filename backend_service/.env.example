# Google Cloud Platform Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET_NAME=aisle-interaction-clips
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=interaction_events

# Model Configuration
# Options: gemini-1.5-flash-002, gemini-1.5-pro-002
GEMINI_MODEL=gemini-1.5-flash-002

# Credentials & Auth
# Optional: Path to Service Account JSON key. If unset, uses Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: If you want to test locally with Google AI Studio instead of Vertex AI
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
