# Google Cloud Platform Configuration
GCP_PROJECT_ID=aisle-retail
GCP_REGION=asia-southeast1
GCS_BUCKET_NAME=aisle-clips-aisle-retail
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=interaction_events

# Data source: "firestore" (default; fails loudly when Firestore or Cloud Storage fail)
# or "seed" (bundled benchmark events in memory, uploads on local disk, for offline work)
AISLE_DATA_SOURCE=firestore

# Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Credentials & Auth
# Optional: Path to Service Account JSON key. If unset, uses Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: If you want to test locally with Google AI Studio instead of Vertex AI
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
