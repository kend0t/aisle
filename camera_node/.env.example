# Backend Service Connection
BACKEND_API_URL=http://localhost:8000
USE_DIRECT_GCS_UPLOAD=false

# Google Cloud Storage (only needed if USE_DIRECT_GCS_UPLOAD=true)
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=aisle-interaction-clips
GOOGLE_APPLICATION_CREDENTIALS=

# Edge Camera & Trigger Configuration
DWELL_THRESHOLD_SECONDS=3.0
BUFFER_SECONDS=10.0
CAMERA_ID=cam_aisle_01
OUTPUT_CLIPS_DIR=staged_clips
HEADLESS=true
